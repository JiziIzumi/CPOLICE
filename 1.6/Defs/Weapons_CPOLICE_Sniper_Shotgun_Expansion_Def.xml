<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseMakeableGun">
    <defName>CPOLICE_CSLR4SniperRifle</defName>
    <label>CS/LR4狙击步枪</label>
    <description>CS/LR4狙击步枪，又称NSG-1，是中国北方工业体系研制的7.62mm高精度栓动狙击步枪系统，可使用7.62×51mm / .308 Winchester弹药，现实中采用5发可拆卸弹匣并配套光学观瞄设备。游戏中设定为威力80、穿甲0.90、射程160。</description>
    <graphicData>
      <texPath>Things/Weapon/CPOLICE_CSLR4SniperRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>6.50</Mass>
      <AccuracyTouch>0.58</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.84</AccuracyMedium>
      <AccuracyLong>0.88</AccuracyLong>
      <RangedWeapon_Cooldown>2.80</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>75</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CPOLICE_Bullet_308Win_CSLR4</defaultProjectile>
        <warmupTime>2.20</warmupTime>
        <range>160</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <soundCast>Shot_SniperRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>SniperRifle</li>
      <li>CPOLICE_SniperRifle</li>
      <li>CPOLICE_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceWeapons</li>
    </thingCategories>
  </ThingDef>
