    <graphicData>
      <texPath>Things/Apparel/CPOLICE_AuxiliarySpecialDutyUniform/CPOLICE_AuxiliarySpecialDutyUniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceApparel</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>105</MaxHitPoints>
      <WorkToMake>800</WorkToMake>
      <Mass>0.90</Mass>
      <Flammability>1.0</Flammability>
      <EquipDelay>2</EquipDelay>
      <ArmorRating_Sharp>0.56</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Heat>0.35</ArmorRating_Heat>
