<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Apparel_CPOLICE_PoliceSuitJacket</defName>
    <label>高级警员｜西装外套</label>
    <description>一件用于高级警务办公、正式执勤、指挥协调和礼仪场合的警察西装外套。外观保持正式警务风格，游戏内提供 90% 防护，可作为普通衬衣外层穿戴。</description>
    <graphicData>
      <texPath>Things/Apparel/CPOLICE/高级警员西装外套/高级警员西装外套</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costList>
      <Cloth>15</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToMake>320</WorkToMake>
      <Mass>1.20</Mass>
      <Flammability>0.2</Flammability>
      <EquipDelay>1</EquipDelay>
      <ArmorRating_Sharp>0.64</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.64</ArmorRating_Blunt>
      <ArmorRating_Heat>0.40</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>1</Insulation_Heat>
    </statBases>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceApparel</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/CPOLICE/高级警员西装外套/高级警员西装外套</wornGraphicPath>
      <layers>
        <li>CPOLICE_Coat</li>
      </layers>
      <useIngredientsForColor>false</useIngredientsForColor>
    </apparel>
    <recipeMaker>
      <recipeUsers>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>2</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
