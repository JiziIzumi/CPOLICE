<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Apparel_CPOLICE_TrafficPeakedCap</defName>
    <label>交警｜大檐帽</label>
    <description>交警大檐帽，防弹防爆属性按80%写入。</description>
    <graphicData>
      <texPath>Things/Apparel/CPOLICE_TrafficPeakedCap/CPOLICE_TrafficPeakedCap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceApparel</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToMake>120</WorkToMake>
      <Mass>0.55</Mass>
      <Flammability>0.2</Flammability>
      <EquipDelay>1</EquipDelay>
      <ArmorRating_Sharp>0.64</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.64</ArmorRating_Blunt>
      <ArmorRating_Heat>0.35</ArmorRating_Heat>
      <Insulation_Cold>2</Insulation_Cold>
      <Insulation_Heat>1</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>15</Cloth>
      <Steel>50</Steel>
    </costList>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/CPOLICE_TrafficPeakedCap/CPOLICE_TrafficPeakedCap</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <bodyPartGroups>
      </bodyPartGroups>
      <useIngredientsForColor>false</useIngredientsForColor>
    </apparel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
<recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>
