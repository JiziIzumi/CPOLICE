<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseMakeableGun">
    <defName>CPOLICE_Type972Shotgun</defName>
    <label>97-2霰弹枪</label>
    <description>97-2霰弹枪参考Hawk Industries / Norinco 97式18.4mm防暴枪系列。该系列由中国北方工业体系生产，面向警用、防暴和军用用途，97-2型号常见于中国警务形象中。游戏中为12G近距离霰弹枪。</description>
    <graphicData>
      <texPath>Things/Weapon/CPOLICE_Type972Shotgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>12000</WorkToMake>
      <Mass>3.18</Mass>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.64</AccuracyShort>
      <AccuracyMedium>0.32</AccuracyMedium>
      <AccuracyLong>0.15</AccuracyLong>
      <RangedWeapon_Cooldown>1.20</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CPOLICE_Bullet_12Gauge</defaultProjectile>
        <warmupTime>0.90</warmupTime>
        <range>20</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <soundCast>Shot_PumpShotgun</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>Shotgun</li>
      <li>CPOLICE_Shotgun</li>
      <li>CPOLICE_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceWeapons</li>
    </thingCategories>
  </ThingDef>
