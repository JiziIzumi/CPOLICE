<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Apparel_CPOLICE_PoliceDutyUniform</defName>
    <label>警察制服</label>
    <description>标准警察制服套装的上衣部分。用于表现正式警务人员在巡逻防控、接处警、治安管理、社区警务和现场处置中的职业身份。制服以深色为主，强调权威、规范和辨识度，可与黑色防护裤、警察巡逻帽或人民警察执勤帽搭配使用。</description>
    <graphicData>
      <texPath>Things/Apparel/CPOLICE_PoliceDutyUniform/CPOLICE_PoliceDutyUniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceApparel</li>
    </thingCategories>
    <techLevel>Industrial</techLevel>
    <costList>
      <Cloth>60</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>105</MaxHitPoints>
      <WorkToMake>4000</WorkToMake>
      <Mass>0.90</Mass>
      <Flammability>1.0</Flammability>
      <EquipDelay>2</EquipDelay>
      <ArmorRating_Sharp>0.56</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Heat>0.35</ArmorRating_Heat>
      <Insulation_Cold>25</Insulation_Cold>
      <Insulation_Heat>25</Insulation_Heat>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/CPOLICE_PoliceDutyUniform/CPOLICE_PoliceDutyUniform</wornGraphicPath>
      <layers>
        <li>CPOLICE_Uniform</li>
      </layers>
    </apparel>
    <recipeMaker>
      <recipeUsers>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
