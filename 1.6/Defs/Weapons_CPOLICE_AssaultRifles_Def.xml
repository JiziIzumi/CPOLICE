<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseMakeableGun">
    <defName>CPOLICE_QBZ95</defName>
    <label>95突击步枪</label>
    <description>95突击步枪参考QBZ-95 / 95式自动步枪。QBZ-95是中国95枪族的核心型号，采用无托布局，发射5.8×42mm弹药，曾广泛装备解放军、武警和其他准军事执法单位。游戏中设定为威力30、穿甲0.50、射程60。</description>
    <graphicData>
      <texPath>Things/Weapon/CPOLICE_QBZ95</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>3.25</Mass>
      <AccuracyTouch>0.62</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>0.24</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CPOLICE_Bullet_58x42_QBZ95</defaultProjectile>
        <warmupTime>0.80</warmupTime>
        <range>60</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>Shot_AssaultRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>Rifle</li>
      <li>CPOLICE_Rifle</li>
      <li>CPOLICE_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceWeapons</li>
    </thingCategories>
  </ThingDef>
