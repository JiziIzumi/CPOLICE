<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseMakeableGun">
    <defName>CPOLICE_Type79SMG</defName>
    <label>79式冲锋枪</label>
    <description>79式冲锋枪是中国在20世纪70年代研制的轻型冲锋枪，最初定位为适合复杂环境使用的近距离自动武器，后来大量装备公安、武警等执法单位。游戏中作为高射速近距离冲锋枪使用，当前已强化为威力26、穿甲0.28、射程44。</description>
    <graphicData>
      <texPath>Things/Weapon/CPOLICE_Type79SMG</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.10</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>1.75</Mass>
      <AccuracyTouch>0.55</AccuracyTouch>
      <AccuracyShort>0.64</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
      <RangedWeapon_Cooldown>0.25</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>45</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CPOLICE_Bullet_SMG_81Power</defaultProjectile>
        <warmupTime>0.75</warmupTime>
        <range>44</range>
        <burstShotCount>5</burstShotCount>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <soundCast>Shot_HeavySMG</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>SMG</li>
      <li>CPOLICE_SMG</li>
      <li>CPOLICE_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>CPOLICE_PoliceWeapons</li>
    </thingCategories>
  </ThingDef>
